{
  "expo": {
    "name": "ZYFF",
    "slug": "zyff",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "zyff",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.zyff.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "uz",
          "ru",
          "en"
        ],
        "CFBundleDevelopmentRegion": "uz"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#000000"
      },
      "package": "uz.zyff.app",
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil rasmingizni yoki mahsulot rasmlarini tanlash uchun galereyaga ruxsat bering.",
          "cameraPermission": "Profil rasmingizni yoki mahsulot rasmlarini olish uchun kameraga ruxsat bering."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "locales": {
      "uz": "./locales/uz.json",
      "ru": "./locales/ru.json",
      "en": "./locales/en.json"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b56d7ee9-41ae-4fc3-9ecd-833e133ea6cd"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b56d7ee9-41ae-4fc3-9ecd-833e133ea6cd"
    }
  }
}
